{
	"name": "snowstorm",
	"version": "3.2.4",
	"description": "Minecraft Bedrock Edition particle editor",
	"author": {
		"name": "JannisX11",
		"email": "info@blockbench.net"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Dbackolds/stormdmc.git"
	},
	"license": "GPL-3.0-or-later",
	"scripts": {
		"dev": "npm run development",
		"development": "mix",
		"watch": "mix watch",
		"watch-poll": "mix watch -- --watch-options-poll=1000",
		"hot": "mix watch --hot",
		"production": "mix --production",
		"extension": "npm run dev",
		"build-extension": "cd ./vscode_extension && vsce package",
		"mcp:install": "npm --prefix mcp_server install",
		"mcp:dev": "npm --prefix mcp_server run dev",
		"mcp:build": "npm --prefix mcp_server run build",
		"mcp:start": "npm --prefix mcp_server run start --",
		"mcp:test": "npm --prefix mcp_server test",
		"mcp:e2e": "npm --prefix mcp_server run e2e",
		"desktop:prepare": "npm run production && npm --prefix mcp_server run build",
		"desktop:dev": "npm run desktop:prepare && electron . --snowstorm-editor",
		"desktop:pack": "npm run desktop:prepare && electron-builder --dir",
		"desktop:build": "npm run desktop:prepare && electron-builder --win nsis"
	},
	"devDependencies": {
		"cross-env": "^7.0.3",
		"electron": "^43.3.0",
		"electron-builder": "^26.15.3",
		"laravel-mix": "^6.0.49",
		"sass": "^1.30.0",
		"sass-loader": "^8.0.2",
		"url-loader": "^4.1.1",
		"vue-loader": "15.9.8",
		"vue-template-compiler": "^2.6.12",
		"webpack": "^5.89.0",
		"webpack-bundle-size-analyzer": "^3.1.0",
		"webpack-cli": "^5.1.4",
		"webpack-dev-server": "^5.0.2"
	},
	"dependencies": {
		"bootstrap": "^4.6.2",
		"fflate": "^0.7.3",
		"lucide-vue": "^0.298.0",
		"molangjs": "^1.6.6",
		"prismjs": "^1.28.0",
		"root": "github:JannisX11/vue-prism-editor",
		"three": "^0.134.0",
		"vue": "^2.6.12",
		"vue-color": "^2.8.2",
		"vue-prism-component": "^1.2.0",
		"wintersky": "^1.3.3"
	},
	"main": "desktop/main.cjs",
	"build": {
		"appId": "com.snowstorm.particle-editor",
		"productName": "Snowstorm",
		"electronDist": "node_modules/electron/dist",
		"artifactName": "Snowstorm-${version}-Setup.${ext}",
		"directories": {"output": "release"},
		"files": [
			"desktop/**/*",
			"index.html",
			"favicon.ico",
			"icon.png",
			"manifest.webmanifest",
			"service_worker.js",
			"dist/**/*",
			"mcp_server/dist/**/*",
			"mcp_server/package.json"
		],
		"extraResources": [
			{"from": "mcp_server/dist", "to": "mcp_server/dist"},
			{"from": "mcp_server/node_modules", "to": "mcp_server/node_modules"}
		],
		"fileAssociations": [
			{"ext": "particle.json", "name": "Minecraft Bedrock Particle", "description": "Snowstorm 粒子文件", "role": "Editor"}
		],
		"win": {
			"target": [{"target": "nsis", "arch": ["x64"]}],
			"icon": "icon.png"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "Snowstorm"
		}
	}
}
